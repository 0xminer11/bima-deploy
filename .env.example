# Deployer key. Must belong to the `investmentManager` address of each target in config/deploy.config.json
# (setPendingBorrower / setTerms are manager-only). Never commit the real .env.
PRIVATE_KEY=0x

# Optional: override the default public RPC for a chain (see rpcEnv in config/deploy.config.json)
# MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
# Optional: a different deployer key per chain (set privateKeyEnv on that chain in the config)
# BASE_PRIVATE_KEY=0x
