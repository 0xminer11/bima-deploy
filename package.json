{
  "name": "bima-deploy",
  "version": "0.1.0",
  "private": true,
  "description": "Config-driven deployment CLI for Bima credit contracts (CollateralFixedTerm loans) across EVM chains",
  "type": "module",
  "scripts": {
    "deploy": "tsx src/cli.ts deploy",
    "deploy:dry": "tsx src/cli.ts deploy --dry-run",
    "list": "tsx src/cli.ts list",
    "check": "tsx src/cli.ts check",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
